# Public Health Outbreak Intelligence Configuration
# This file shows available environment variables but should NOT be committed

# Database path (relative to project root)
DATABASE_PATH=data/outbreak_intel.db

# User agent for HTTP requests
USER_AGENT=PublicHealthOutbreakIntelligence/0.1.0 (+https://github.com/Carlosdanger96/public-health-outbreak-intelligence)

# HTTP timeout in seconds
HTTP_TIMEOUT=30

# Maximum retries for failed requests
MAX_RETRIES=3

# Demo mode - uses fixtures instead of live data
DEMO_MODE=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
